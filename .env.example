# Copy to .env on the local machine. Do not commit .env or credentials.
AU5800_DB=data/au5800.sqlite
AU5800_PORT=3001
# Must match the deployed origin exactly; local development also permits localhost.
AU5800_PUBLIC_ORIGIN=http://127.0.0.1:3001
# Set true only behind an HTTPS endpoint. This round is not a full production deployment.
AU5800_COOKIE_SECURE=false
# Bootstrap is a local CLI only. Leave the password empty for a hidden interactive prompt.
AU5800_BOOTSTRAP_USERNAME=000029220
AU5800_BOOTSTRAP_PASSWORD=
